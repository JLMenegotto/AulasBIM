  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "09e16d46765744358c392d75e0c03d18",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "ec88cdcdf25f483290dd3cdaea4b7138",
          "Name": "ele",
          "Description": "ele",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "aac78bdf6c9c476fbdb523d465097b44",
          "Name": "ip",
          "Description": "ip",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "7e63f20470124879aa84e9e86821bc4d",
          "Name": "ele",
          "Description": "ele",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "ec420f2417ec42bbb43173db4d7adaa8",
          "Name": "ip",
          "Description": "ip",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a35e74b971394841a566dc6607799912",
          "Name": "pared",
          "Description": "pared = Revit.Elements.FamilyInstance.GetHost(ele)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "b035a1a518884fe3be0023ded388ba74",
          "Name": "grupo",
          "Description": "grupo = List.GroupByKey(ele, pared)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "6f279c7948634cfbab83ae60f2ea1962",
          "Name": "wal",
          "Description": "wal = DesignScript.Builtin.Get.ValueAtIndex(DesignScript.Builtin.Get.ValueAtIndex(grupo, \"unique keys\"), ip)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "96f439cabcc547eb810deef3a2f5c3b6",
          "Name": "grp",
          "Description": "grp = DesignScript.Builtin.Get.ValueAtIndex(DesignScript.Builtin.Get.ValueAtIndex(grupo, \"groups\"), ip)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a375185a94bc45b3b5405dd309772be0",
          "Name": "q",
          "Description": "q = (List.Count(grp)) + 1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "97b35af07f3d4fedb0b68c7a7c7c78d5",
          "Name": "lin",
          "Description": "lin = wal.GetLocation()",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "5051eb71efa14613816258301248480c",
          "Name": "tba",
          "Description": "tba = grp.GetLocation()",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "59ccd206a16246a1bde68a195a5567e5",
          "Name": "dim",
          "Description": "dim = lin.Length",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "156ab15c531f4fc8916ff9e0160fd505",
          "Name": "dis",
          "Description": "dis = DSCore.Math.Round(dim / q, 2)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "71e4eebf6974439d84def7b4346caae2",
          "Name": "pin",
          "Description": "pin = lin.PointsAtEqualSegmentLength(q)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a2da4aafc3b74647b63bc0a4e64d2da7",
          "Name": "pfi",
          "Description": "pfi = List.Flatten(pin, 1)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c7445fe5cc7e4bedaaf8a170fb708e29",
          "Name": "function",
          "Description": "grp.SetLocation(pfi)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "ele;\nip;\n//----------------------------------------------\n// Agrupa elementos pela parede que os hospedam\n// Podem ser portas, janelas, tomadas, etc.\n//----------------------------------------------\npared = FamilyInstance.GetHost(  ele  );\ngrupo = List.GroupByKey ( ele , pared );\nwal   = grupo[\"unique keys\"][ip];\ngrp   = grupo[\"groups\"     ][ip];\n//---------------------------------------------\n// Processa os itens do grupo de índice i\n//---------------------------------------------\nq     = List.Count(grp)+1;\nlin   = wal.GetLocation();\ntba   = grp.GetLocation();\ndim   = lin.Length;\ndis   = Math.Round (dim / q, 2);\npin   = lin.PointsAtEqualSegmentLength(q);\npfi   = List.Flatten ( pin , 1 );\n//---------------------------------------------\n// Reposiciona os elementos equidistantes\n//---------------------------------------------\ngrp.SetLocation ( pfi );"
    },
