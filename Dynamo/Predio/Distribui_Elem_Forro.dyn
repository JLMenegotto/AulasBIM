  "Nodes": [
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "09e16d46765744358c392d75e0c03d18",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "037d51299c264673ae6b243da52a2c11",
          "Name": "ele",
          "Description": "ele",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0098ff5e175c4155a114c06a47527014",
          "Name": "ip",
          "Description": "ip",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "d78df6a9211f4e6cb5771d84ef91164c",
          "Name": "ele",
          "Description": "ele",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e28dee19888c45a98b88b68c8acd1a4e",
          "Name": "ip",
          "Description": "ip",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "8253e4073f3a466cb372e96516d6a6d4",
          "Name": "cs",
          "Description": "cs = Autodesk.DesignScript.Geometry.CoordinateSystem.ByOrigin(cen)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "42b7fc1f5e8249d78938c6c876539ffe",
          "Name": "alt",
          "Description": "alt = -0.052 / 2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "571f55ef26814bd8b10f60ba0bd76b58",
          "Name": "rai",
          "Description": "rai = 1.45",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "b1ca80a3e1e14196839a8601f1781cf9",
          "Name": "hospe",
          "Description": "hospe = Revit.Elements.FamilyInstance.GetHost(ele)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "b4126fd3ae454dceb2fc586cb78cc7ae",
          "Name": "agrup",
          "Description": "agrup = List.GroupByKey(ele, hospe)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "7858410727ba45698bc58735782ea9da",
          "Name": "hos",
          "Description": "hos = DesignScript.Builtin.Get.ValueAtIndex(DesignScript.Builtin.Get.ValueAtIndex(agrup, \"unique keys\"), ip)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3e0ec5f574cc457c8f394bc6e7f0ef80",
          "Name": "grp",
          "Description": "grp = DesignScript.Builtin.Get.ValueAtIndex(DesignScript.Builtin.Get.ValueAtIndex(agrup, \"groups\"), ip)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "426b37c5b9e945b09b028112fce2c3a9",
          "Name": "q",
          "Description": "q = List.Count(grp)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "ea9f6c657b394dc48a3fcb798d92dd5f",
          "Name": "sol",
          "Description": "sol = Revit.Elements.Ceiling.GetGeometry(hos)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "53d969e9cc234274b8116ea002d49f1b",
          "Name": "cen",
          "Description": "cen = Autodesk.DesignScript.Geometry.Solid.Centroid(sol)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "7e57609f30b54006b2559c9c0db6e052",
          "Name": "faa",
          "Description": "faa = (0..360..360 / q)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "8bbdb8d7b76f4862bf4cfc7747076ae0",
          "Name": "ang",
          "Description": "ang = List.DropItems(faa, 1)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "33d5bfea9a774fe99e8d9aed4cae58a4",
          "Name": "pin",
          "Description": "pin = Autodesk.DesignScript.Geometry.Point.ByCylindricalCoordinates(cs, ang<1>, alt, rai)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "8eb62796fd1d4489836c2e00a5aa2f25",
          "Name": "pfi",
          "Description": "pfi = List.Flatten(pin, 1)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1748d8654a1b435c9849dd2d09d07bb5",
          "Name": "function",
          "Description": "grp.SetLocation(pfi)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "ele;\nip;\n//----------------------------------------------------------\n// Como o Centroide do sólido do forro se posiciona acima da\n// face com a metade da espessura, se guarda a variável alt\n// com esse valor negativo para que ao calcular a posição\n// o ponto possa se deslocar para abaixo.\n// O aluno pode desenvolver uma função para que que esse\n// valor seja automáticamente extraído da familia tipo do\n// forro. No momento o valor (-0.052) está determinado.\n//\n// O outro valor determinado é o raio.\n// Com ele se organizam os pontos ao redor do ponto\n// central do forro. Esse valor, evidentemente, não pode ser\n// maior que a metade da menor largura do ambiente descontado\n// o raio da luminária e um valor de distância às paredes,\n// pois senão a luminária cairá fora do compartimento ou numa\n// posição inconveniente.\n//----------------------------------------------------------\ncs    = CoordinateSystem.ByOrigin( cen );\nalt   = -0.052/2;\nrai   = 1.45;\n//----------------------------------------------------------\n// Agrupa elementos e os ceilings que os hospedam\n// Podem ser luminárias, detectores, sensores, etc.\n// Processa os itens do grupo de índice ip\n//----------------------------------------------------------\nhospe = FamilyInstance.GetHost (  ele         );\nagrup = List.GroupByKey        (  ele , hospe );\nhos   = agrup[\"unique keys\"][ip];\ngrp   = agrup[\"groups\"     ][ip];\n//----------------------------------------------------------\n// Utiliza o Ceiling para capturar a posição atual\n//----------------------------------------------------------\nq     = List.Count          ( grp );\nsol   = Ceiling.GetGeometry ( hos );\ncen   = Solid.Centroid      ( sol );\nfaa   = 0..360..(360/q);\nang   = List.DropItems      ( faa , 1 );\n//----------------------------------------------------------\n// Reposiciona os elementos com o ordenamento programado\n//----------------------------------------------------------\npin   = Point.ByCylindricalCoordinates(cs, ang<1>, alt, rai);\npfi   = List.Flatten ( pin , 1 );\ngrp.SetLocation ( pfi );"
    },
