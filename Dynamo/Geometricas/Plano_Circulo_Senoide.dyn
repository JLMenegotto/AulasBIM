      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "pa = Point.ByCoordinates(x1 , y1 , z1);\npb = Point.ByCoordinates(x2 , 0  , 0 );\n//--------------------------------------\n// Define a normal do plano diretor com\n// o vetor p1 p2\n//--------------------------------------\ndi = Vector.ByTwoPoints   (pa , pb );\npl = Plane.ByOriginNormal (pa , di );\n//--------------------------------------\n// Define o círculo sobre o plano\n//--------------------------------------\nLi = Line.ByStartPointEndPoint(pa , pb);\nCi = Circle.ByPlaneRadius     (pl , 10);"
    }
