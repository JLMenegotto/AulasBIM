      "Outputs": [],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "def FazCirculo ( pa, pb, r, i, m )\n{\n ra = i%m ? r : r/m;\n vd = Vector.ByTwoPoints  ( pa, pb );\n pl = Plane.ByOriginNormal( pa, vd );\n ci = Circle.ByPlaneRadius( pl, ra );\n return = ci;\n};"
    },
