          "KeepListStructure": false
        },
        {
          "Id": "84d459b141974756b89b0e3f5a4d4b0e",
          "Name": "r",
          "Description": "r",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c03b74e890694ba9b1b5f186e86fbd87",
          "Name": "m",
          "Description": "m",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "46d56adae70e4270ac1464be1a8665d3",
          "Name": "amp",
          "Description": "amp",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c2c0c502042f4abd8c220c0609599d12",
          "Name": "r",
          "Description": "r",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0e6407c96b704593a74e1a2ff6275310",
          "Name": "m",
          "Description": "m",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0c3ab124d91345a39b417bbb0617f464",
          "Name": "qpo",
          "Description": "qpo = 360 * 2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "b17cd37d6d2f4415bb443bfffee28b48",
          "Name": "x",
          "Description": "x = (0..qpo)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "aeae12df71504ca79c3ebeb8c823107c",
          "Name": "i",
          "Description": "i = (0..qpo - 1)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "cfa601ae9d0d4140aedda6bf2c6eb132",
          "Name": "j",
          "Description": "j = i + 1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "7f187c068fa54b1ea43b456a80dee7b6",
          "Name": "s",
          "Description": "s = DSCore.Math.Sin(x)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "73361905b6b34e34bc18318abe412c3a",
          "Name": "y",
          "Description": "y = (DSCore.Math.RadiansToDegrees(s)) * amp",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d29e850d2ce84e6a9bf30efbef95abd7",
          "Name": "Pt",
          "Description": "Pt = Autodesk.DesignScript.Geometry.Point.ByCoordinates(x, y, 0)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "397d38eadcb840dd94894e95ec400471",
          "Name": "ci",
          "Description": "ci = FazCirculo(DesignScript.Builtin.Get.ValueAtIndex(Pt, i), DesignScript.Builtin.Get.ValueAtIndex(Pt, j), (i + 1) * r, i, m)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "amp;\nr;\nm;\nqpo = 360*2;\nx   = 0..qpo;\ni   = 0..qpo-1;\nj   = i+1;\ns   = Math.Sin(x);\ny   = Math.RadiansToDegrees(s)*amp;\nPt  = Point.ByCoordinates(x, y, 0);\nci  = FazCirculo (Pt[i], Pt[j], (i+1)*r, i, m);"
    },
    {
      "ConcreteType": "CoreNodeModels.Input.DoubleSlider, CoreNodeModels",
      "NumberType": "Double",
      "MaximumValue": 10.0,
      "MinimumValue": -2.0,
      "StepValue": 0.2,
      "Id": "fc1ada51e8a34595b9bce6e3ba76522c",
      "NodeType": "NumberInputNode",
      "Inputs": [],
      "Outputs": [
