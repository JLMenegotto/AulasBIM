          "Name": "pa",
          "Description": "pa = Autodesk.DesignScript.Geometry.Point.ByCoordinates(x1, y1, z1)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "092c1f2044d140b79952ed1c4d3f7a07",
          "Name": "pb",
          "Description": "pb = Autodesk.DesignScript.Geometry.Point.ByCoordinates(x2, 0, 0)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2f61c54cffa14f6d8140ddf251623884",
          "Name": "di",
          "Description": "di = Autodesk.DesignScript.Geometry.Vector.ByTwoPoints(pa, pb)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "bb40f86a1f114266887c3cb3be0a1ea1",
          "Name": "pl",
          "Description": "pl = Autodesk.DesignScript.Geometry.Plane.ByOriginNormal(pa, di)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "873669f9d9654389b4b2a6a0f94b2b32",
          "Name": "Li",
          "Description": "Li = Autodesk.DesignScript.Geometry.Line.ByStartPointEndPoint(pa, pb)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e04fb633954046afa3bd4a7e8569b64f",
          "Name": "Ci",
          "Description": "Ci = Autodesk.DesignScript.Geometry.Circle.ByPlaneRadius(pl, 10)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "pa = Point.ByCoordinates(x1 , y1 , z1);\npb = Point.ByCoordinates(x2 , 0  , 0 );\n//--------------------------------------\n// Define a normal do plano diretor com\n// o vetor p1 p2\n//--------------------------------------\ndi = Vector.ByTwoPoints   (pa , pb );\npl = Plane.ByOriginNormal (pa , di );\n//--------------------------------------\n// Define o círculo sobre o plano\n//--------------------------------------\nLi = Line.ByStartPointEndPoint(pa , pb);\nCi = Circle.ByPlaneRadius     (pl , 10);"
    }
