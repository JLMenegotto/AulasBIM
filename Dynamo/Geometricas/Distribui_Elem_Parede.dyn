        },
        {
          "Id": "41d7ba1f382d4d8b9bc5b62bac9e7465",
          "Name": "ele",
          "Description": "ele",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "a004c03ccc1d432fb105a238569e8c9f",
          "Name": "par",
          "Description": "par",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "51db44c18f6a48c4806a63010ca5abe1",
          "Name": "ele",
          "Description": "ele",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d6d72075e1f440919cdbfe979f739d83",
          "Name": "q",
          "Description": "q = List.Count(ele)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d86479602eac4439896cc1483964795b",
          "Name": "eix",
          "Description": "eix = par.GetLocation()",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "91c4fb7da93047b88fea328e3505e758",
          "Name": "tom",
          "Description": "tom = ele.GetLocation()",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "54f79a9e7d564778ad48f51527dbe0d6",
          "Name": "dim",
          "Description": "dim = eix.Length",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2e9f54c05e634dfa92dda099f1212aff",
          "Name": "dis",
          "Description": "dis = DSCore.Math.Round(dim / (q + 1), 2)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "b7773450cda846939576a9849f3fa60f",
          "Name": "pin",
          "Description": "pin = eix.PointsAtEqualSegmentLength(q + 1)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "051f5a3a9dba4f7ab4db8b2ff41bfc67",
          "Name": "pfi",
          "Description": "pfi = List.Flatten(pin, 1)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2ae9f28004244379869eed9e6a616c6e",
          "Name": "function",
          "Description": "ele.SetLocation(pfi)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "par;\nele;\nq   = List.Count(ele);\neix = par.GetLocation();\ntom = ele.GetLocation();\ndim = eix.Length;\ndis = Math.Round (dim / (q+1), 2);\npin = eix.PointsAtEqualSegmentLength(q+1);\npfi = List.Flatten ( pin , 1 );\n//------------------------------------------------\nele.SetLocation ( pfi );"
    },
