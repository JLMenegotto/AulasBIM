  "Nodes": [
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "09e16d46765744358c392d75e0c03d18",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "82a95df097a749fdac6654d10c3c228e",
          "Name": "ele",
          "Description": "ele",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "b22b52fdb1d5495a86e1c8d4facafa6e",
          "Name": "i",
          "Description": "i",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "71189799b43041f8aa81d62f8f071237",
          "Name": "ele",
          "Description": "ele",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "26ffbab0a6d14379bc151c2667e8be88",
          "Name": "i",
          "Description": "i",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e0e209110fdf44ea8b2819a85ddb3ec4",
          "Name": "pared",
          "Description": "pared = Revit.Elements.FamilyInstance.GetHost(ele)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "ce60cd6e18544aae9717b406b6105d37",
          "Name": "grupo",
          "Description": "grupo = List.GroupByKey(ele, pared)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "261eb087c97e4f75af89deb35956a726",
          "Name": "wal",
          "Description": "wal = DesignScript.Builtin.Get.ValueAtIndex(DesignScript.Builtin.Get.ValueAtIndex(grupo, \"unique keys\"), i)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "18f48aa66a114333bd8f054a8dad7181",
          "Name": "grp",
          "Description": "grp = DesignScript.Builtin.Get.ValueAtIndex(DesignScript.Builtin.Get.ValueAtIndex(grupo, \"groups\"), i)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3f39119a748e4fd0973f322aed18d648",
          "Name": "q",
          "Description": "q = List.Count(grp)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "67a8c5052e8d454a9f596c6b4572c429",
          "Name": "eix",
          "Description": "eix = wal.GetLocation()",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "95dda5f0836c45babbd19476fb93864f",
          "Name": "tba",
          "Description": "tba = grp.GetLocation()",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0ee92476711e45838afdb8ccabcf6aa6",
          "Name": "dim",
          "Description": "dim = eix.Length",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e1447f0d7f1f4e7ea2b4e37979263272",
          "Name": "dis",
          "Description": "dis = DSCore.Math.Round(dim / (q + 1), 2)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "762233fd8ba34090bbff8c114d953106",
          "Name": "pin",
          "Description": "pin = eix.PointsAtEqualSegmentLength(q + 1)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "11d5f68b4841425ab9c8451f22d28593",
          "Name": "pfi",
          "Description": "pfi = List.Flatten(pin, 1)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c328bf6caf154598940637aae6dca2b7",
          "Name": "function",
          "Description": "grp.SetLocation(pfi)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "ele;\ni;\n//----------------------------------------------\n// Agrupa tomadas por parede que a hospeda\n//----------------------------------------------\npared = FamilyInstance.GetHost( ele   );\ngrupo = List.GroupByKey ( ele , pared );\nwal   = grupo[\"unique keys\"][i];\ngrp   = grupo[\"groups\"     ][i];\n//---------------------------------------------\n// Processa os itens do grupo de índice i\n//---------------------------------------------\nq     = List.Count(grp);\neix   = wal.GetLocation();\ntba   = grp.GetLocation();\ndim   = eix.Length;\ndis   = Math.Round (dim / (q+1), 2);\npin   = eix.PointsAtEqualSegmentLength(q+1);\npfi   = List.Flatten ( pin , 1 );\n//---------------------------------------------\n// Reposiciona os elementos equidistantes\n//---------------------------------------------\ngrp.SetLocation ( pfi );"
    },
