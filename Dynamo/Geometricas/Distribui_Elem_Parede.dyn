  "Nodes": [
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "09e16d46765744358c392d75e0c03d18",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "7ab5dfe8a5db40bba72f675c6b5822fb",
          "Name": "ele",
          "Description": "ele",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "40cb4731e9f648ea9a58fd3b5e37bb22",
          "Name": "i",
          "Description": "i",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "a01452880580420dbf7bae03bd290c88",
          "Name": "ele",
          "Description": "ele",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2a63b2be29554f4bb671ae2e2ad49ee1",
          "Name": "i",
          "Description": "i",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "ad9c56395cc04316b32d8605830bfb31",
          "Name": "pared",
          "Description": "pared = Revit.Elements.FamilyInstance.GetHost(ele)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "6d6f42fe22f94cf6a5f083bfbd6e72f0",
          "Name": "grupo",
          "Description": "grupo = List.GroupByKey(ele, pared)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "7c6d9ab1dca840829656bf71e8ce1c7d",
          "Name": "wal",
          "Description": "wal = DesignScript.Builtin.Get.ValueAtIndex(DesignScript.Builtin.Get.ValueAtIndex(grupo, \"unique keys\"), i)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0461dbed9f2b4aa4aadda732c5d9040c",
          "Name": "grp",
          "Description": "grp = DesignScript.Builtin.Get.ValueAtIndex(DesignScript.Builtin.Get.ValueAtIndex(grupo, \"groups\"), i)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "46a823596caa411b9aa1b502b7d5eaf7",
          "Name": "q",
          "Description": "q = (List.Count(grp)) + 1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c2732ac924294d35a740195bbef394c9",
          "Name": "lin",
          "Description": "lin = wal.GetLocation()",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "953b745d10d64910a2edb041dabe9a78",
          "Name": "tba",
          "Description": "tba = grp.GetLocation()",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "4d0ac580abef4638a1a936065d0aaf44",
          "Name": "dim",
          "Description": "dim = lin.Length",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "84f5ebdd882445e6a4ac30fe4271ff69",
          "Name": "dis",
          "Description": "dis = DSCore.Math.Round(dim / q, 2)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "982bdf7bce154e21a75424f8bc8d79b9",
          "Name": "pin",
          "Description": "pin = lin.PointsAtEqualSegmentLength(q)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0c855d2d51174df2a4e771dbba2471af",
          "Name": "pfi",
          "Description": "pfi = List.Flatten(pin, 1)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "85166bb6dc704d35bf4b0015b55f5d92",
          "Name": "function",
          "Description": "grp.SetLocation(pfi)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "ele;\ni;\n//----------------------------------------------\n// Agrupa elementos pela parede que os hospedam\n// Podem ser portas, janelas, tomadas, etc.\n//----------------------------------------------\npared = FamilyInstance.GetHost(  ele  );\ngrupo = List.GroupByKey ( ele , pared );\nwal   = grupo[\"unique keys\"][i];\ngrp   = grupo[\"groups\"     ][i];\n//---------------------------------------------\n// Processa os itens do grupo de índice i\n//---------------------------------------------\nq     = List.Count(grp)+1;\nlin   = wal.GetLocation();\ntba   = grp.GetLocation();\ndim   = lin.Length;\ndis   = Math.Round (dim / q, 2);\npin   = lin.PointsAtEqualSegmentLength(q);\npfi   = List.Flatten ( pin , 1 );\n//---------------------------------------------\n// Reposiciona os elementos equidistantes\n//---------------------------------------------\ngrp.SetLocation ( pfi );"
    },
